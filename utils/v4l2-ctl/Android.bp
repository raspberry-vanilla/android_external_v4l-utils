cc_binary {
    name: "v4l2-ctl",
    vendor: true,
    generated_headers: [
        "media_bus_format_names_header",
    ],
    srcs: [
        "codec-fwht.c",
        "codec-v4l2-fwht.c",
        "media-info.cpp",
        "v4l-stream.c",
        "v4l2-ctl-common.cpp",
        "v4l2-ctl-edid.cpp",
        "v4l2-ctl-io.cpp",
        "v4l2-ctl-meta.cpp",
        "v4l2-ctl-misc.cpp",
        "v4l2-ctl-modes.cpp",
        "v4l2-ctl-overlay.cpp",
        "v4l2-ctl-sdr.cpp",
        "v4l2-ctl-selection.cpp",
        "v4l2-ctl-stds.cpp",
        "v4l2-ctl-streaming.cpp",
        "v4l2-ctl-subdev.cpp",
        "v4l2-ctl-tuner.cpp",
        "v4l2-ctl-vbi.cpp",
        "v4l2-ctl-vidcap.cpp",
        "v4l2-ctl-vidout.cpp",
        "v4l2-ctl.cpp",
        "v4l2-info.cpp",
        "v4l2-tpg-colors.c",
        "v4l2-tpg-core.c",
    ],
    cflags: [
        "-DNO_LIBV4L2",
    ],
    defaults: ["v4l-utils_defaults"],
}
