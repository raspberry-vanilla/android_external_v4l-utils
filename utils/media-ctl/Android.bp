cc_binary {
    name: "media-ctl",
    vendor: true,
    srcs: [
        "libmediactl.c",
        "libv4l2subdev.c",
        "media-ctl.c",
        "options.c",
    ],
    header_libs: ["v4l-utils_headers"],
    shared_libs: ["libudev"],
    cflags: [
        "-include android-config.h",
        "-DHAVE_LIBUDEV",
    ],
}
